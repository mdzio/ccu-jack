#!/bin/sh

# Add-on information
ADDON_ID=ccu-jack
ADDON_NAME="CCU-Jack"
ADDON_DESCR_EN="CCU-Jack provides simple and secure REST-based access to CCU data points."
ADDON_DESCR_DE="CCU-Jack bietet einen einfachen und sicheren REST-basierten Zugriff auf die Datenpunkte der CCU."

# Directories
ADDON_DIR=/usr/local/addons/${ADDON_ID}
ETC_DIR=/usr/local/etc
RCD_DIR=/usr/local/etc/config/rc.d
WWW_DIR=/usr/local/etc/config/addons/www/${ADDON_ID}

# Logging to syslog is currently not supported by the CCU during the install process.

if ! machine=$(uname -m); then
  echo "${ADDON_NAME}: failed to determine machine architecture" >&2
  exit 1
fi
case "$machine" in
  armv6l) target=rm-rp0+1 ;;
  armv7l|armv8l) target=ccu3-rm-rp2+3 ;;
  aarch64|arm64) target=rm-rp4 ;;
  i386|i486|i586|i686|x86) target=vccu-x86 ;;
  x86_64|amd64) target=vccu-x86_64 ;;
  *)
    echo "${ADDON_NAME}: unsupported machine architecture: $machine" >&2
    exit 1
    ;;
esac

BINARY="bin/ccu-jack-$target"
if [ ! -f "$BINARY" ]; then
  echo "${ADDON_NAME}: missing binary: $BINARY" >&2
  exit 1
fi

if [ "$1" = "" ]; then
  echo "${ADDON_NAME} Add-On is not for CCU1"
  lcdtool "Add-On is not for CCU1   "
  exit 1
elif [ "$1" = "CCU2" ]; then
  echo "Installing on CCU2"
  mount -t ubifs ubi1:user /usr/local
# A CCU3 currently masquerades as OpenCCU/RaspberryMatic. CCU3 is currently not defined, but it can happen. 
elif [ "$1" = "HM-RASPBERRYMATIC" ] || [ "$1" = "CCU3" ]; then
  echo "Installing on CCU3/RaspberryMatic"
  mount /usr/local 2> /dev/null
fi

# Stop ccu-jack, if already installed.
if [ -f $RCD_DIR/${ADDON_ID} ]; then
  echo "Previous installation detected"
  $RCD_DIR/${ADDON_ID} stop
fi

# Create directories
mkdir -p ${ADDON_DIR}
chmod 755 ${ADDON_DIR}
mkdir -p ${RCD_DIR}
chmod 755 ${RCD_DIR}
mkdir -p ${WWW_DIR}
chmod 755 ${WWW_DIR}

# Copy addon
if ! cp -af addon/* "${ADDON_DIR}/"; then
  echo "${ADDON_NAME}: failed to copy add-on files" >&2
  exit 1
fi
if ! cp -af "$BINARY" "${ADDON_DIR}/${ADDON_ID}"; then
  echo "${ADDON_NAME}: failed to install binary: $BINARY" >&2
  exit 1
fi

# Remove binaries installed by the earlier universal add-on launcher.
if ! rm -f "${ADDON_DIR}/bin/ccu-jack-rm-rp0+1" \
  "${ADDON_DIR}/bin/ccu-jack-ccu3-rm-rp2+3" \
  "${ADDON_DIR}/bin/ccu-jack-rm-rp4" \
  "${ADDON_DIR}/bin/ccu-jack-vccu-x86" \
  "${ADDON_DIR}/bin/ccu-jack-vccu-x86_64"; then
  echo "${ADDON_NAME}: failed to remove previous binaries" >&2
  exit 1
fi

# Copy startup script
cp -af rc.d/* ${RCD_DIR}/

# Copy www directory
cp -af www/* ${WWW_DIR}/

# Copy config files
cp -af etc/* ${ETC_DIR}/

# Create configuration file, if it does not already exist.
if [ ! -e "${ADDON_DIR}/ccu-jack.cfg" ]; then
  echo "Creating configuration file"
  cp ${ADDON_DIR}/ccu-jack-default.cfg ${ADDON_DIR}/ccu-jack.cfg
fi

# Add menu entry
cp -af addon/update_hm_addons.tcl ${ADDON_DIR}/
${ADDON_DIR}/update_hm_addons.tcl -a ${ADDON_ID} -name "${ADDON_NAME}" -url /addons/${ADDON_ID}/config.cgi -de "${ADDON_DESCR_DE}" -en "${ADDON_DESCR_EN}"

sync
echo "Installed"

# Force a reboot on RM and CCU3, CCU2 always reboots after addon installation.
if [ "$1" = "HM-RASPBERRYMATIC" ] || [ "$1" = "CCU3" ]; then
  exit 10
fi

exit 0
